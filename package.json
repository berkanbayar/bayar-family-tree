{
  "name": "bayar-family-tree",
  "version": "2.0.0",
  "private": true,
  "description": "Bayar Ailesi Soy Ağacı: mobil öncelikli, kendi veritabanıyla çalışan aile ağacı uygulaması",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "node --env-file-if-exists=.env --watch server/index.js",
    "seed": "node --env-file-if-exists=.env scripts/seed.js",
    "test": "node --test \"test/*.test.js\""
  },
  "engines": {
    "node": ">=22.9"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "express": "^5.2.1",
    "nodemailer": "^10.0.13"
  }
}
