# Kopyalayın: cp .env.example .env

PORT=3000
APP_URL=https://bayar.dijitapro.com.tr
# DB_PATH=./data/family.db

# ── Giriş: e-posta ile (önerilen) ─────────────────────────────
# Bu adresler her zaman yöneticidir. Diğer aile üyeleri uygulamada Menü → Üyeler'den davet edilir.
ADMIN_EMAILS=berkanki@gmail.com

# Giriş kodlarının gönderileceği SMTP hesabı
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=soyagaci@dijitapro.com.tr
# 465 portu kullanılıyorsa: SMTP_SECURE=1

# 1 yapılırsa giriş yapmayanlar da ağacı görür (telefon/e-posta/notlar gizli kalır). Boş = site kapalı.
PUBLIC_VIEW=

# ── Giriş: şifre ile (isteğe bağlı, yedek yöntem) ─────────────
# ADMIN_PASSWORD=
# VIEW_PASSWORD=

# Oturum imzası için uzun rastgele bir değer:
#   openssl rand -hex 32
SESSION_SECRET=

# Nginx / Caddy gibi bir ters vekil arkasında HTTPS ile çalışıyorsa 1 yapın (docker-compose zaten 1 yapar)
TRUST_PROXY=0
