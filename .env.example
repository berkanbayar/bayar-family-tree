# Kopyalayın: cp .env.example .env

PORT=3000
# DB_PATH=./data/family.db

# Yönetici şifresi (ekleme / düzenleme / içe aktarma). Boş bırakılırsa herkes düzenleyebilir!
ADMIN_PASSWORD=

# Aile şifresi. Tanımlanırsa site tamamen kapalı olur, sadece şifreyle görüntülenir.
# Tanımlanmazsa ağaç herkese açık görünür (telefon, e-posta ve notlar gizli kalır).
VIEW_PASSWORD=

# Oturum imzası için uzun rastgele bir değer:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Nginx / Caddy gibi bir ters vekil (reverse proxy) arkasında HTTPS ile çalışıyorsa 1 yapın
TRUST_PROXY=0
